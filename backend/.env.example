# =============================================================================
# LEVELOP BACKEND — variables de entorno
# Copiar este archivo a `.env` y rellenar. `.env` NUNCA se sube al repositorio.
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Base de datos (Railway) -------------------------------------------------
# La URL completa la da Railway al crear el Postgres. Es la del rol dueno,
# usada SOLO para migraciones y para el arranque de la app.
DATABASE_URL=postgresql://usuario:password@host:5432/levelop

# --- Los cuatro roles de conexion (R-07 estructural) -------------------------
# Cada superficie se conecta con un rol distinto de Postgres. El del BackOffice
# LITERALMENTE no tiene SELECT sobre las tablas prohibidas por R-07: un bug de
# codigo no puede filtrar lo que la conexion no puede leer.
# Estas contrasenas las genera `scripts/apply-role-grants.ts` la primera vez.
DB_ROLE_APP_URL=postgresql://levelop_app:password@host:5432/levelop
DB_ROLE_BACKOFFICE_URL=postgresql://levelop_backoffice:password@host:5432/levelop
DB_ROLE_LIDER_URL=postgresql://levelop_lider:password@host:5432/levelop
DB_ROLE_INTERNO_URL=postgresql://levelop_interno:password@host:5432/levelop

# --- Auth --------------------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esto-por-un-secreto-real-de-96-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Economia ----------------------------------------------------------------
# Ojo: los multiplicadores y precios NO viven aqui. Viven en configuracion
# versionada por tenant en la base de datos, porque CH-5 los va a cambiar y no
# quiero un despliegue por cada ajuste. Aqui solo van limites de seguridad.
ORO_CAP_DIARIO_DEFAULT=150
ORO_DECAY_DIAS=90
DERIVA_RELOJ_MAX_MINUTOS=120

# --- «Quien necesita una mano» ----------------------------------------------
# Salvaguarda 3: minimo de semanas de patron sostenido antes de que alguien
# aparezca en el panel. El umbral vive en el query, no en la UI.
HELP_UMBRAL_DIAS=21
# Retencion del historial (enmienda de Alim del 01/09 a la salvaguarda 5).
HELP_HISTORIAL_RETENCION_DIAS=90

# --- CORS --------------------------------------------------------------------
# Lista separada por comas de los origenes que pueden llamar al backend desde un
# navegador (ej. https://app.levelop.com,https://backoffice.levelop.com).
#
# VACIO = modo desarrollo: se acepta cualquier origen, incluido el `null` que
# manda Chrome cuando se abre un HTML como archivo local. Comodo para probar los
# prototipos, inaceptable en produccion. ANTES DE DESPLEGAR, LLENAR ESTO.
CORS_ORIGIN=

# --- Observabilidad ----------------------------------------------------------
SENTRY_DSN=
